# Copy this file to .env and fill in your own values.
# Never commit real keys; .env is gitignored, this file is not.

# Supabase (Project Settings -> API / Database)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@your-pooler-host.pooler.supabase.com:6543/postgres

# App Config
ENVIRONMENT=development

# Qdrant Vector DB (Qdrant Cloud -> cluster -> API keys)
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Groq (LLM)
GROQ_API_KEY=your-groq-api-key
# Chat model from https://console.groq.com/docs/models (change it when Groq retires one)
GROQ_MODEL=openai/gpt-oss-120b
# low / medium / high for reasoning models like gpt-oss; leave empty for models without reasoning
GROQ_REASONING_EFFORT=low
